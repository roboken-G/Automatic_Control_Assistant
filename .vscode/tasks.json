{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Active File",
            "type": "shell",
            "command": "bash",
            "args": [
                ".vscode/run_target.sh",        // 作成したスクリプト
                "${file}",                      // 引数1: フルパス
                "${fileBasenameNoExtension}",   // 引数2: 拡張子なしファイル名
                "${fileDirname}",               // 引数3: ディレクトリ
                "${fileExtname}",               // 引数4: 拡張子
                "${workspaceFolder}"            // 引数5: ワークスペースルート
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}